+#[tokio::test]
+async fn renderer_cleans_up_descendants_after_timeout_and_success() {
+    for finish in ["import time;time.sleep(10)", "pass"] {
+        let dir = tempdir().unwrap();
+        let ticks = dir.path().join("ticks");
+        let pidfile = dir.path().join("pid");
+        let descendant = format!(
+            "import time\nf=open({:?},'a',buffering=1)\nfor _ in range(250):\n f.write('x');f.flush();time.sleep(0.02)\n",
+            ticks.to_string_lossy()
+        );
+        let code = format!(
+            "import subprocess,sys,time,pathlib\np=subprocess.Popen([sys.executable,'-c', {descendant:?}],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)\npathlib.Path({:?}).write_text(str(p.pid))\nwhile not pathlib.Path({:?}).exists(): time.sleep(0.005)\n{finish}",
+            pidfile.to_string_lossy(),
+            ticks.to_string_lossy()
+        );
+        let command = vec![
+            if cfg!(windows) {
+                "python".into()
+            } else {
+                "python3".into()
+            },
+            "-c".into(),
+            code,
+        ];
+        let _ = run_renderer(&command, json!({})).await;
+        tokio::time::sleep(Duration::from_millis(100)).await;
+        let before = std::fs::metadata(&ticks).unwrap().len();
+        tokio::time::sleep(Duration::from_millis(200)).await;
+        let after = std::fs::metadata(&ticks).unwrap().len();
+        let pid = std::fs::read_to_string(pidfile).unwrap();
+        let _ = std::process::Command::new(&command[0])
+            .args([
+                "-c",
+                &format!("import os,signal;os.kill({pid},signal.SIGTERM)"),
+            ])
+            .stderr(Stdio::null())
+            .status();
+        assert_eq!(
+            before, after,
+            "renderer descendant remained active: {finish}"
+        );
+    }
+}
