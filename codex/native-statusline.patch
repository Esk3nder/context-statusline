+#[tokio::test]
+async fn renderer_handles_argv_spaces_and_delivers_json_on_stdin() {
+    let dir = tempdir().unwrap();
+    let script = dir.path().join("renderer with spaces.py");
+    std::fs::write(&script, "import json,sys\nx=json.load(sys.stdin)\nprint('\\x1b[1mCTX ' + str(x['columns']) + '\\x1b[0m')\n").unwrap();
+    let result = run_renderer(
+        &[
+            if cfg!(windows) {
+                "python".into()
+            } else {
+                "python3".into()
+            },
+            script.to_string_lossy().into(),
+        ],
+        json!({"columns":80}),
+    )
+    .await
+    .unwrap();
+    assert_eq!(result[0].to_string(), "CTX 80");
+    assert!(
+        result[0].spans[0]
+            .style
+            .add_modifier
+            .contains(ratatui::style::Modifier::BOLD)
+    );
+}
