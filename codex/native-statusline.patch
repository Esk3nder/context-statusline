+#[cfg(unix)]
+#[test]
+fn private_backend_accepts_only_the_verified_upstream_socket_alias() {
+    use sha2::Digest;
+    use std::os::unix::ffi::OsStrExt;
+    use std::os::unix::fs::PermissionsExt;
+    let dir = tempdir().unwrap();
+    std::fs::set_permissions(dir.path(), std::fs::Permissions::from_mode(0o700)).unwrap();
+    let path = dir.path().join("app-server.sock");
+    let canonical = std::fs::canonicalize(dir.path())
+        .unwrap()
+        .join("app-server.sock");
+    let hash = sha2::Sha256::digest(canonical.as_os_str().as_bytes());
+    let real = codex_uds::prepare_shared_daemon_socket_directory()
+        .unwrap()
+        .join(format!("{hash:x}"));
+    let listener = std::os::unix::net::UnixListener::bind(&real).unwrap();
+    std::os::unix::fs::symlink(&real, &path).unwrap();
+    let result = local_backend_at(&path);
+    drop(listener);
+    std::fs::remove_file(&real).unwrap();
+    let target = result.unwrap();
+    assert!(matches!(target, crate::AppServerTarget::LocalDaemon {
+        endpoint: codex_app_server_client::RemoteAppServerEndpoint::UnixSocket { socket_path },
+        allow_embedded_fallback: false,
+    } if socket_path.as_path() == real));
+    assert!(local_backend_at(&path).is_err());
+}
