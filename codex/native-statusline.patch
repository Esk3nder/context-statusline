+    panel.update(json!({"session_id":"main"}));
+    panel.observe(&tool_event("main"), Some("main".into()));
+    panel.inner.lock().unwrap().lines = vec!["OLD_THREAD".into()];
+    panel.update(json!({"session_id":"other"}));
+    let inner = panel.inner.lock().unwrap();
+    assert!(inner.tools.is_empty());
+    assert!(inner.lines.is_empty());
+}
