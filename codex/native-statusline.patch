+#[tokio::test]
+async fn renderer_stdin_is_bounded_and_internal_roles_are_not_forwarded() {
+    let dir = tempdir().unwrap();
+    let capture = dir.path().join("capture.json");
+    let code = format!(
+        "import pathlib,sys;pathlib.Path({:?}).write_bytes(sys.stdin.buffer.read());print('ok')",
+        capture.to_string_lossy()
+    );
+    let panel = Panel::new(
+        vec![
+            if cfg!(windows) {
+                "python".into()
+            } else {
+                "python3".into()
+            },
+            "-c".into(),
+            code,
+        ],
+        FrameRequester::test_dummy(),
+    );
+    let oversized = "x\n\u{202e}".repeat(100_000);
+    panel.update(json!({"session_id":"main", "model":oversized, "cwd":oversized, "branch":oversized, "agent_roles":{"child":oversized}}));
+    panel
+        .inner
+        .lock()
+        .unwrap()
+        .agents
+        .insert("child".into(), json!({"id":"child", "status":"running"}));
+    panel.refresh(80);
+    for _ in 0..200 {
+        if capture.exists() {
+            break;
+        }
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    let raw = std::fs::read(capture).unwrap();
+    assert!(
+        raw.len() < 16_384,
+        "metadata crossed subprocess boundary without bounds: {}",
+        raw.len()
+    );
+    let value: Value = serde_json::from_slice(&raw).unwrap();
+    assert!(value.get("agent_roles").is_none());
+    for text in [
+        &value["model"],
+        &value["cwd"],
+        &value["branch"],
+        &value["agents"][0]["role"],
+    ] {
+        let text = text.as_str().unwrap();
+        assert!(text.chars().count() <= 512);
+        assert!(!text.chars().any(|c| c.is_control() || c == '\u{202e}'));
+    }
+}
