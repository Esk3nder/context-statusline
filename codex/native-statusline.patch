+//! Opt-in external status panel. Model behavior, persistence and native config stay unchanged.
+use crate::render::renderable::Renderable;
+use crate::tui::FrameRequester;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::ThreadItem;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::text::Line;
+use ratatui::widgets::Paragraph;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::process::Stdio;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::time::Duration;
+use std::time::Instant;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use unicode_width::UnicodeWidthStr;
+
+mod process;
+
+pub(crate) const BACKEND_SOCKET: &str = "CODEX_STATUSLINE_BACKEND_SOCKET";
+const COMMAND_ENV: &str = "CODEX_STATUSLINE_COMMAND";
+
+/// Renderer command resolved once per process from the launcher environment.
+/// Widgets never read the environment themselves, so test processes stay panel-free.
+static COMMAND: OnceLock<Vec<String>> = OnceLock::new();
+
+/// Resolve `CODEX_STATUSLINE_COMMAND` once at startup. A malformed value is a launch
+/// error, matching how a bad `CODEX_STATUSLINE_BACKEND_SOCKET` is treated.
+pub(crate) fn configure_from_env() -> std::io::Result<()> {
+    let Ok(raw) = std::env::var(COMMAND_ENV) else {
+        return Ok(());
+    };
+    let command = parse_command(&raw)
+        .map_err(|reason| std::io::Error::other(format!("invalid {COMMAND_ENV}: {reason}")))?;
+    let _ = COMMAND.set(command);
+    Ok(())
+}
+
+fn parse_command(raw: &str) -> Result<Vec<String>, String> {
+    let command: Vec<String> =
+        serde_json::from_str(raw).map_err(|_| "expected a JSON array of strings".to_owned())?;
+    if command.is_empty() {
+        return Err("command must name a program".to_owned());
+    }
+    if command.len() > 16 {
+        return Err("command accepts at most 16 arguments".to_owned());
+    }
+    if command
+        .iter()
+        .any(|arg| arg.len() > 4096 || arg.contains('\0'))
+    {
+        return Err("arguments must be under 4096 bytes and NUL-free".to_owned());
+    }
+    Ok(command)
+}
+
+pub(crate) fn local_backend_from_env() -> std::io::Result<Option<crate::AppServerTarget>> {
+    let Some(path) = std::env::var_os(BACKEND_SOCKET) else {
+        return Ok(None);
+    };
+    #[cfg(unix)]
+    return local_backend_at(std::path::Path::new(&path)).map(Some);
+    #[cfg(not(unix))]
+    {
+        let _ = path;
+        Err(std::io::Error::other(
+            "private statusline backend requires a Unix socket",
+        ))
+    }
+}
+
+#[cfg(unix)]
+fn local_backend_at(path: &std::path::Path) -> std::io::Result<crate::AppServerTarget> {
+    use std::os::unix::fs::FileTypeExt;
+    use std::os::unix::fs::MetadataExt;
+    let parent = path
+        .parent()
+        .ok_or_else(|| std::io::Error::other("missing socket directory"))?;
+    let directory = std::fs::symlink_metadata(parent)?;
+    let advertised = std::fs::symlink_metadata(path)?;
+    let uid = unsafe { libc::geteuid() };
+    if !path.is_absolute()
+        || !directory.is_dir()
+        || directory.uid() != uid
+        || directory.mode() & 0o077 != 0
+        || advertised.uid() != uid
+    {
+        return Err(std::io::Error::other(
+            "statusline backend socket must be owned and private",
+        ));
+    }
+    // Official Codex advertises an alias to a deterministic endpoint in its
+    // protected executor-local directory. Reuse upstream's validation so an
+    // arbitrary symlink cannot redirect this local, credential-bearing client.
+    let endpoint = if advertised.file_type().is_symlink() {
+        codex_app_server_client::verified_local_daemon_socket(path)?
+            .ok_or_else(|| std::io::Error::other("unverified statusline backend alias"))?
+    } else {
+        codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(path)?
+    };
+    let socket = std::fs::symlink_metadata(endpoint.as_path())?;
+    if !socket.file_type().is_socket() || socket.uid() != uid {
+        return Err(std::io::Error::other("invalid statusline backend socket"));
+    }
+    Ok(crate::AppServerTarget::LocalDaemon {
+        endpoint: codex_app_server_client::RemoteAppServerEndpoint::UnixSocket {
+            socket_path: endpoint,
+        },
+        // Never read credentials in the patched embedded process after a backend failure.
+        allow_embedded_fallback: false,
+    })
+}
+
+const INTERVAL: Duration = Duration::from_millis(500);
+/// Longer than the refresh interval so a slow run only delays the next refresh; runs never
+/// overlap because `pending` serializes them.
+const TIMEOUT: Duration = Duration::from_secs(2);
+const MAX_OUTPUT: u64 = 65536;
+/// Hard transport limit on parsed rows. The screen-relative cap is applied at render time.
+const MAX_ROWS: usize = 64;
+const TAB_STOP: usize = 8;
+
+#[derive(Default)]
+struct Inner {
+    payload: Value,
+    session: Option<String>,
+    plan: Vec<Value>,
+    tools: BTreeMap<String, Value>,
+    agents: BTreeMap<String, Value>,
+    limits: Vec<Value>,
+    used_mcps: BTreeSet<String>,
+    lines: Vec<Line<'static>>,
+    width: u16,
+    generation: u64,
+    pending: bool,
+    last_started: Option<Instant>,
+    partial: bool,
+}
+
+pub(crate) struct Panel {
+    command: Vec<String>,
+    inner: Arc<Mutex<Inner>>,
+    frame: FrameRequester,
+    attached: Instant,
+}
+
+impl Inner {
+    /// Thread-scoped state belongs to one session. A payload update and an observed notification
+    /// can learn of a switch in either order, so whichever comes first resets the state.
+    fn enter_session(&mut self, session: Option<&str>) {
+        let Some(session) = session else {
+            return;
+        };
+        if self.session.as_deref() == Some(session) {
+            return;
+        }
+        self.session = Some(session.to_owned());
+        self.plan.clear();
+        self.tools.clear();
+        self.agents.clear();
+        self.lines.clear();
+        self.used_mcps.clear();
+        self.partial = false;
+        self.generation += 1;
+    }
+}
+
+impl Panel {
+    /// The panel for this process, if `configure_from_env` resolved a renderer command.
+    pub(crate) fn configured(frame: FrameRequester) -> Option<Self> {
+        COMMAND
+            .get()
+            .map(|command| Self::new(command.clone(), frame))
+    }
+
+    pub(crate) fn new(command: Vec<String>, frame: FrameRequester) -> Self {
+        Self {
+            command,
+            inner: Arc::default(),
+            frame,
+            attached: Instant::now(),
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn used_mcps_for_test(&self) -> Vec<String> {
+        self.inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .used_mcps
+            .iter()
+            .cloned()
+            .collect()
+    }
+
+    #[cfg(test)]
+    pub(crate) fn plan_for_test(&self) -> Vec<Value> {
+        self.inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .plan
+            .clone()
+    }
+
+    #[cfg(test)]
+    pub(crate) fn payload_for_test(&self) -> Value {
+        self.inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .payload
+            .clone()
+    }
+
+    #[cfg(test)]
+    pub(crate) fn set_lines_for_test(&self, lines: Vec<Line<'static>>, width: u16) {
+        let mut inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        inner.lines = lines;
+        inner.width = width;
+    }
+
+    pub(crate) fn update(&self, mut payload: Value) {
+        for key in ["session_id", "model", "cwd", "branch"] {
+            if let Some(value) = payload[key].as_str() {
+                payload[key] = json!(label(value));
+            }
+        }
+        if let Some(roles) = payload["agent_roles"].as_object() {
+            payload["agent_roles"] = json!(
+                roles
+                    .iter()
+                    .take(64)
+                    .map(|(id, role)| (label(id), label(role.as_str().unwrap_or("agent"))))
+                    .collect::<BTreeMap<_, _>>()
+            );
+        }
+        let mut inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        inner.enter_session(payload["session_id"].as_str());
+        payload["attached_ms"] = json!(self.attached.elapsed().as_millis() as u64);
+        inner.payload = payload;
+    }
+
+    pub(crate) fn observe(&self, notification: &ServerNotification, active: Option<String>) {
+        let mut inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        inner.enter_session(active.as_deref());
+        match notification {
+            ServerNotification::TurnPlanUpdated(n) if Some(&n.thread_id) == active.as_ref() => {
+                inner.partial |= n.plan.len() > 256;
+                inner.plan = n
+                    .plan
+                    .iter()
+                    .take(256)
+                    .map(|step| json!({"step":label(&step.step),"status":step.status}))
+                    .collect();
+            }
+            ServerNotification::ItemStarted(n)
+                if Some(&n.thread_id) == active.as_ref()
+                    || inner.agents.contains_key(&n.thread_id) =>
+            {
+                observe_item(
+                    &mut inner,
+                    &n.item,
+                    false,
+                    &n.thread_id,
+                    n.started_at_ms as f64 / 1000.0,
+                );
+            }
+            ServerNotification::ItemCompleted(n)
+                if Some(&n.thread_id) == active.as_ref()
+                    || inner.agents.contains_key(&n.thread_id) =>
+            {
+                observe_item(&mut inner, &n.item, true, &n.thread_id, 0.0);
+            }
+            ServerNotification::TurnCompleted(n)
+                if Some(&n.thread_id) == active.as_ref()
+                    || inner.agents.contains_key(&n.thread_id) =>
+            {
+                inner
+                    .tools
+                    .retain(|_, tool| tool["agent_id"] != n.thread_id);
+            }
+            ServerNotification::AccountRateLimitsUpdated(n)
+                if n.rate_limits
+                    .limit_id
+                    .as_deref()
+                    .is_none_or(|id| id == "codex") =>
+            {
+                inner.limits = [&n.rate_limits.primary, &n.rate_limits.secondary].into_iter().flatten().map(|w| json!({
+                    "used_percent":w.used_percent,"window_minutes":w.window_duration_mins,"resets_at":w.resets_at
+                })).collect();
+            }
+            _ => {}
+        }
+    }
+
+    /// Replayed history bypasses notification dispatch; items arrive already complete, so this
+    /// rebuilds the used-MCP and known-agent sets without listing running tools.
+    pub(crate) fn observe_replayed_item(&self, item: &ThreadItem, thread: &str) {
+        let mut inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        inner.enter_session(Some(thread));
+        observe_item(&mut inner, item, true, thread, 0.0);
+    }
+
+    fn refresh(&self, width: u16) {
+        self.frame.schedule_frame_in(INTERVAL);
+        let mut inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if inner.pending
+            || inner.last_started.is_some_and(|at| at.elapsed() < INTERVAL)
+            || self.command.is_empty()
+        {
+            return;
+        }
+        let mut payload = inner.payload.clone();
+        payload["columns"] = json!(width);
+        payload["attached_ms"] = json!(self.attached.elapsed().as_millis() as u64);
+        payload["plan"] = json!(inner.plan);
+        payload["tools"] = json!(
+            inner
+                .tools
+                .values()
+                .filter(|tool| tool["agent_id"] == payload["session_id"])
+                .collect::<Vec<_>>()
+        );
+        payload["agents"] = json!(
+            inner
+                .agents
+                .values()
+                .map(|agent| {
+                    let mut agent = agent.clone();
+                    agent["tools"] = json!(
+                        inner
+                            .tools
+                            .values()
+                            .filter(|tool| tool["agent_id"] == agent["id"])
+                            .collect::<Vec<_>>()
+                    );
+                    if let Some(role) =
+                        payload["agent_roles"].get(agent["id"].as_str().unwrap_or_default())
+                    {
+                        agent["role"] = role.clone();
+                    }
+                    agent
+                })
+                .collect::<Vec<_>>()
+        );
+        if let Some(object) = payload.as_object_mut() {
+            object.remove("agent_roles");
+        }
+        payload["used"] = json!({"mcps":inner.used_mcps});
+        payload["limits"] = json!(inner.limits);
+        payload["partial"] = json!(inner.partial);
+        let generation = inner.generation;
+        inner.pending = true;
+        inner.last_started = Some(Instant::now());
+        let state = Arc::downgrade(&self.inner);
+        let command = self.command.clone();
+        let frame = self.frame.clone();
+        tokio::spawn(async move {
+            let result = run_renderer(&command, payload).await;
+            if let Some(state) = state.upgrade() {
+                let mut state = state
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner);
+                state.pending = false;
+                // A failed or slow run keeps the last good output so the layout does not jump.
+                if state.generation == generation
+                    && let Ok(lines) = result
+                {
+                    state.lines = lines;
+                    state.width = width;
+                }
+                frame.schedule_frame();
+            }
+        });
+    }
+}
+
+pub(crate) fn label(value: &str) -> String {
+    value
+        .chars()
+        .filter(|c| !c.is_control() && !matches!(*c, '\u{061c}' | '\u{200e}' | '\u{200f}' | '\u{202a}'..='\u{202e}' | '\u{2066}'..='\u{2069}'))
+        .take(512)
+        .collect()
+}
+
+fn observe_item(inner: &mut Inner, item: &ThreadItem, completed: bool, thread: &str, at: f64) {
+    let (id, tool) = match item {
+        ThreadItem::CommandExecution { id, .. } => (id, "Shell".to_owned()),
+        ThreadItem::FileChange { id, .. } => (id, "Edit".to_owned()),
+        ThreadItem::McpToolCall {
+            id,
+            server,
+            tool,
+            status,
+            ..
+        } => {
+            if completed
+                && *status == codex_app_server_protocol::McpToolCallStatus::Completed
+                && inner.used_mcps.len() < 32
+            {
+                inner.used_mcps.insert(label(server));
+            }
+            (id, format!("MCP {} {}", label(server), label(tool)))
+        }
+        ThreadItem::DynamicToolCall { id, tool, .. } => (id, label(tool)),
+        ThreadItem::CollabAgentToolCall {
+            id,
+            tool,
+            agents_states,
+            ..
+        } => {
+            for (agent_id, state) in agents_states.iter().take(64) {
+                if inner.agents.len() < 64 || inner.agents.contains_key(agent_id) {
+                    inner.agents.insert(
+                        label(agent_id),
+                        json!({"id":label(agent_id),"role":"agent","status":state.status}),
+                    );
+                } else {
+                    inner.partial = true;
+                }
+            }
+            (id, json!(tool).as_str().unwrap_or("agent").to_owned())
+        }
+        _ => return,
+    };
+    let key = format!("{thread}:{}", label(id));
+    if completed {
+        inner.tools.remove(&key);
+    } else if inner.tools.len() < 64 {
+        inner.tools.entry(key).or_insert_with(
+            || json!({"id":label(id),"tool":tool,"at":at,"agent_id":label(thread)}),
+        );
+    } else {
+        inner.partial = true;
+    }
+}
+
+impl Renderable for Panel {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        // Lines rendered for another width stay visible, truncated, until the refresh at this
+        // width lands; a resize must not blank the panel.
+        Renderable::render(&Paragraph::new(inner.lines.clone()), area, buf);
+    }
+    fn desired_height(&self, width: u16) -> u16 {
+        self.refresh(width);
+        let inner = self
+            .inner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        inner.lines.len() as u16
+    }
+}
+
+async fn run_renderer(command: &[String], payload: Value) -> Result<Vec<Line<'static>>, ()> {
+    let raw = serde_json::to_vec(&payload).map_err(|_| ())?;
+    if raw.len() > 1_048_576 {
+        return Err(());
+    }
+    let work = async {
+        let mut command_builder = tokio::process::Command::new(command.first().ok_or(())?);
+        command_builder
+            .args(&command[1..])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null());
+        let (mut child, _tree) = process::spawn(&mut command_builder).map_err(|_| ())?;
+        let mut stdin = child.stdin.take().ok_or(())?;
+        let mut stdout = child.stdout.take().ok_or(())?.take(MAX_OUTPUT + 1);
+        let writer = async {
+            // A renderer may exit without reading its stdin; its stdout and exit status
+            // still decide the outcome.
+            match stdin.write_all(&raw).await {
+                Ok(()) => {}
+                Err(error) if error.kind() == std::io::ErrorKind::BrokenPipe => {}
+                Err(_) => return Err(()),
+            }
+            drop(stdin);
+            Ok::<_, ()>(())
+        };
+        let reader = async {
+            let mut output = Vec::new();
+            stdout.read_to_end(&mut output).await.map_err(|_| ())?;
+            if output.len() as u64 > MAX_OUTPUT {
+                return Err(());
+            }
+            Ok(output)
+        };
+        let (_, output) = tokio::try_join!(writer, reader)?;
+        if !child.wait().await.map_err(|_| ())?.success() {
+            return Err(());
+        }
+        parse_output(&output)
+    };
+    tokio::time::timeout(TIMEOUT, work).await.map_err(|_| ())?
+}
+
+fn parse_output(output: &[u8]) -> Result<Vec<Line<'static>>, ()> {
+    let text = std::str::from_utf8(output).map_err(|_| ())?;
+    // Only SGR styling survives. OSC, cursor controls, clipboard/title writes and C0 are discarded.
+    let mut safe = String::new();
+    // Columns measured so far on the current row, plus the visible text since the last
+    // measurement point. Rendering splits spans at SGR sequences and sums their string widths
+    // (so a ZWJ emoji is one cluster inside a span but not across one), and this measurement
+    // flushes at the same boundaries. Flushing at tabs too keeps the cost linear.
+    let mut column = 0usize;
+    let mut segment = String::new();
+    let mut chars = text.chars().peekable();
+    while let Some(c) = chars.next() {
+        if c == '\t' {
+            column += std::mem::take(&mut segment).width();
+            let spaces = TAB_STOP - column % TAB_STOP;
+            safe.extend(std::iter::repeat_n(' ', spaces));
+            column += spaces;
+        } else if c == '\n' {
+            safe.push(c);
+            column = 0;
+            segment.clear();
+        } else if c == '\x1b' {
+            match chars.next() {
+                Some('[') => {
+                    let mut sequence = String::new();
+                    for next in chars.by_ref() {
+                        if ('@'..='~').contains(&next) {
+                            if next == 'm'
+                                && sequence.len() <= 128
+                                && sequence
+                                    .chars()
+                                    .all(|c| c.is_ascii_digit() || c == ';' || c == ':')
+                            {
+                                safe.push_str(&format!("\x1b[{sequence}m"));
+                                column += std::mem::take(&mut segment).width();
+                            }
+                            break;
+                        }
+                        if sequence.len() <= 128 {
+                            sequence.push(next);
+                        }
+                    }
+                }
+                Some(']' | 'P' | '_' | '^') => {
+                    let mut escaped = false;
+                    for next in chars.by_ref() {
+                        if next == '\x07' || (escaped && next == '\\') {
+                            break;
+                        }
+                        escaped = next == '\x1b';
+                    }
+                }
+                _ => {}
+            }
+        } else if !c.is_control() && !matches!(c, '\u{202a}'..='\u{202e}' | '\u{2066}'..='\u{2069}')
+        {
+            safe.push(c);
+            segment.push(c);
+        }
+    }
+    let mut lines = codex_ansi_escape::ansi_escape(&safe).lines;
+    if lines.last().is_some_and(|line| line.width() == 0) {
+        lines.pop();
+    }
+    if lines.len() > MAX_ROWS {
+        lines.truncate(MAX_ROWS - 1);
+        lines.push(format!(" ! Statusline clipped at {MAX_ROWS} rows").into());
+    }
+    Ok(lines)
+}
