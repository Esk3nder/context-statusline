+#[tokio::test]
+async fn renderer_failure_timeout_and_output_limit_are_bounded() {
+    for code in [
+        "raise SystemExit(2)",
+        "import time;time.sleep(10)",
+        "print('x'*70000)",
+    ] {
+        let started = Instant::now();
+        assert!(
+            run_renderer(
+                &[
+                    if cfg!(windows) {
+                        "python".into()
+                    } else {
+                        "python3".into()
+                    },
+                    "-c".into(),
+                    code.into()
+                ],
+                json!({})
+            )
+            .await
+            .is_err()
+        );
+        assert!(started.elapsed() < Duration::from_secs(3));
+    }
+}
