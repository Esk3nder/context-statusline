+fn tool_event(thread: &str) -> ServerNotification {
+    serde_json::from_value(json!({"method":"item/started","params":{
+    "threadId":thread,"turnId":"turn","startedAtMs":0,"item":{
+        "type":"dynamicToolCall","id":"call","namespace":null,"tool":"Read",
+        "arguments":{"command":"SECRET_COMMAND","prompt":"SECRET_PROMPT"},
+        "status":"inProgress","contentItems":null,"success":null,"durationMs":null
+    }}}))
+    .unwrap()
+}
