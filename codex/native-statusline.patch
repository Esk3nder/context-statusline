@@ -0,0 +1,37 @@
+//! Own the renderer tree on every exit, including cancellation and successful rendering.
+use std::io;
+use tokio::process::Child;
+use tokio::process::Command;
+
+pub(super) struct Tree {
+    #[cfg(unix)]
+    pid: u32,
+    #[cfg(windows)]
+    _job: codex_utils_pty::JobObject,
+}
+
+#[cfg(unix)]
+impl Drop for Tree {
+    fn drop(&mut self) {
+        let _ = codex_utils_pty::process_group::kill_process_group(self.pid);
+    }
+}
+
+pub(super) fn spawn(command: &mut Command) -> io::Result<(Child, Tree)> {
+    command.kill_on_drop(true);
+    #[cfg(unix)]
+    {
+        let child = command.process_group(0).spawn()?;
+        let pid = child
+            .id()
+            .ok_or_else(|| io::Error::other("missing renderer PID"))?;
+        Ok((child, Tree { pid }))
+    }
+    #[cfg(windows)]
+    {
+        // Fail closed: assignment happens while suspended, before any descendants can spawn.
+        let job = codex_utils_pty::JobObject::create_without_breakaway()?;
+        let child = job.spawn_contained(command)?;
+        Ok((child, Tree { _job: job }))
+    }
+}
