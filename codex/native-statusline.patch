+    assert_eq!(rows[0].to_string(), "👩\u{200d}💻      X");
+    assert_eq!(rows[1].to_string(), "✔\u{fe0f}      Y");
+    // An SGR inside a cluster splits it into two spans at render time; the measurement agrees.
+    let rows = parse_output("👩\x1b[31m\u{200d}💻\tX\n".as_bytes()).unwrap();
+    assert_eq!(rows[0].to_string(), "👩\u{200d}💻    X");
+    assert_eq!(rows[0].width(), 9);
+}
+
+#[test]
+fn tab_expansion_is_linear_in_the_output_size() {
+    let started = std::time::Instant::now();
+    let rows = parse_output(&vec![b'\t'; 65_536]).unwrap();
+    assert_eq!(rows[0].width(), 65_536 * TAB_STOP);
+    assert!(
+        started.elapsed() < Duration::from_secs(2),
+        "{:?}",
+        started.elapsed()
+    );
+}
+
+#[test]
+fn renderer_command_is_validated_once_and_rejects_malformed_values() {
+    assert_eq!(
+        parse_command(r#"["python3","render.py"]"#).unwrap(),
+        vec!["python3".to_owned(), "render.py".to_owned()]
+    );
+    for raw in ["~/sl.sh", "[]", r#"["a\u0000b"]"#, "{\"cmd\":1}"] {
+        assert!(parse_command(raw).is_err(), "accepted {raw:?}");
+    }
+    let many = serde_json::to_string(&vec!["x"; 17]).unwrap();
+    assert!(parse_command(&many).is_err());
+    // Nothing configured this process, so widgets built in tests never spawn a renderer.
+    assert!(Panel::configured(FrameRequester::test_dummy()).is_none());
+}
+
+#[test]
+fn resizing_keeps_the_last_output_visible_until_the_next_refresh() {
+    let panel = Panel::new(vec![], FrameRequester::test_dummy());
+    panel.set_lines_for_test(vec!["CTX 37%  QUOTA 22%".into(), "second row".into()], 80);
+    assert_eq!(panel.desired_height(40), 2);
+    let mut buf = Buffer::empty(Rect::new(0, 0, 10, 2));
+    panel.render(Rect::new(0, 0, 10, 2), &mut buf);
+    assert_eq!(buf[(0, 0)].symbol(), "C");
+    assert_eq!(buf[(0, 1)].symbol(), "s");
+}
+
+fn collab_item(tool: &str) -> ThreadItem {
+    serde_json::from_value(json!({
+        "type":"collabAgentToolCall","id":"collab-1","tool":tool,"status":"completed",
+        "senderThreadId":"main","receiverThreadIds":["child"],"prompt":null,"model":null,
+        "reasoningEffort":null,"agentsStates":{"child":{"status":"running","message":null}}
+    }))
+    .unwrap()
+}
+
+#[test]
+fn replayed_history_rebuilds_used_mcps_and_known_agents() {
+    let panel = Panel::new(vec![], FrameRequester::test_dummy());
+    let mcp: ThreadItem = serde_json::from_value(json!({
+        "type":"mcpToolCall","id":"mcp-1","server":"github","tool":"search","status":"completed",
+        "arguments":{},"result":null,"error":null,"durationMs":null,"mcpApp":null,"contentItems":null
+    }))
+    .unwrap();
+    panel.observe_replayed_item(&mcp, "main");
+    panel.observe_replayed_item(&collab_item("spawnAgent"), "main");
+    assert_eq!(panel.used_mcps_for_test(), vec!["github".to_owned()]);
+    let inner = panel.inner.lock().unwrap();
+    assert!(inner.tools.is_empty(), "history never lists running tools");
+    assert_eq!(inner.agents.len(), 1);
+}
+
+#[test]
+fn collab_tool_names_use_the_protocol_spelling() {
+    let panel = Panel::new(vec![], FrameRequester::test_dummy());
+    let mut inner = panel.inner.lock().unwrap();
+    observe_item(&mut inner, &collab_item("spawnAgent"), false, "main", 1.0);
+    assert_eq!(inner.tools.values().next().unwrap()["tool"], "spawnAgent");
+}
