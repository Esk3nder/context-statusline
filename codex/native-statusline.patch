+use super::*;
+use pretty_assertions::assert_eq;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use tempfile::tempdir;
+
+#[tokio::test]
+async fn renderer_handles_argv_spaces_and_delivers_json_on_stdin() {
+    let dir = tempdir().unwrap();
+    let script = dir.path().join("renderer with spaces.py");
+    std::fs::write(&script, "import json,sys\nx=json.load(sys.stdin)\nprint('\\x1b[1mCTX ' + str(x['columns']) + '\\x1b[0m')\n").unwrap();
+    let result = run_renderer(
+        &[
+            if cfg!(windows) {
+                "python".into()
+            } else {
+                "python3".into()
+            },
+            script.to_string_lossy().into(),
+        ],
+        json!({"columns":80}),
+    )
+    .await
+    .unwrap();
+    assert_eq!(result[0].to_string(), "CTX 80");
+    assert!(
+        result[0].spans[0]
+            .style
+            .add_modifier
+            .contains(ratatui::style::Modifier::BOLD)
+    );
+}
+
+#[tokio::test]
+async fn renderer_failure_timeout_and_output_limit_are_bounded() {
+    for code in [
+        "raise SystemExit(2)",
+        "import time;time.sleep(10)",
+        "print('x'*70000)",
+    ] {
+        let started = Instant::now();
+        assert!(
+            run_renderer(
+                &[
+                    if cfg!(windows) {
+                        "python".into()
+                    } else {
+                        "python3".into()
+                    },
+                    "-c".into(),
+                    code.into()
+                ],
+                json!({})
+            )
+            .await
+            .is_err()
+        );
+        assert!(started.elapsed() < Duration::from_secs(3));
+    }
+}
+
+#[test]
+fn unsafe_terminal_sequences_are_removed_and_rows_are_capped() {
+    let rows = parse_output(b"\x1b]52;c;SECRET\x07safe\x1b[2J\r\x1b[1mbold\x1b[0m\n").unwrap();
+    assert_eq!(rows[0].to_string(), "safebold");
+    let rows = parse_output("line\n".repeat(100).as_bytes()).unwrap();
+    assert_eq!(rows.len(), 64);
+    assert!(rows[63].to_string().contains("clipped"));
+}
+
+#[test]
+fn panel_snapshot_is_styled_and_clips_without_touching_composer_rows() {
+    let lines = parse_output("CONTEXT USED     5H QUOTA USED\n\x1b[38;2;74;222;128m████░░\x1b[0m          █░░░░░\n37%              22%\n".as_bytes()).unwrap();
+    let mut buf = Buffer::empty(Rect::new(0, 0, 44, 5));
+    let panel = Panel::new(vec![], FrameRequester::test_dummy());
+    panel.inner.lock().unwrap().lines = lines;
+    panel.inner.lock().unwrap().width = 44;
+    panel.render(Rect::new(0, 0, 44, 3), &mut buf);
+    insta::assert_snapshot!(
+        buf.content
+            .iter()
+            .map(ratatui::buffer::Cell::symbol)
+            .collect::<String>()
+    );
+    assert_eq!(buf[(0, 3)].symbol(), " ");
+}
+
+fn tool_event(thread: &str) -> ServerNotification {
+    serde_json::from_value(json!({"method":"item/started","params":{
+    "threadId":thread,"turnId":"turn","startedAtMs":0,"item":{
+        "type":"dynamicToolCall","id":"call","namespace":null,"tool":"Read",
+        "arguments":{"command":"SECRET_COMMAND","prompt":"SECRET_PROMPT"},
+        "status":"inProgress","contentItems":null,"success":null,"durationMs":null
+    }}}))
+    .unwrap()
+}
+
+#[test]
+fn metadata_is_allowlisted_and_child_tool_ids_cannot_replace_main_calls() {
+    let panel = Panel::new(vec![], FrameRequester::test_dummy());
+    panel.update(json!({"session_id":"main"}));
+    panel
+        .inner
+        .lock()
+        .unwrap()
+        .agents
+        .insert("child".into(), json!({"id":"child","status":"running"}));
+    panel.observe(&tool_event("main"), Some("main".into()));
+    panel.observe(&tool_event("child"), Some("main".into()));
+    panel.observe(&tool_event("unrelated"), Some("main".into()));
+    let inner = panel.inner.lock().unwrap();
+    assert_eq!(inner.tools.len(), 2);
+    assert!(inner.tools.contains_key("main:call"));
+    assert!(inner.tools.contains_key("child:call"));
+    assert!(
+        !serde_json::to_string(&inner.tools)
+            .unwrap()
+            .contains("SECRET")
+    );
+}
+
+#[test]
+fn switching_threads_discards_cached_metadata_and_output() {
+    let panel = Panel::new(vec![], FrameRequester::test_dummy());
+    panel.update(json!({"session_id":"main"}));
+    panel.observe(&tool_event("main"), Some("main".into()));
+    panel.inner.lock().unwrap().lines = vec!["OLD_THREAD".into()];
+    panel.update(json!({"session_id":"other"}));
+    let inner = panel.inner.lock().unwrap();
+    assert!(inner.tools.is_empty());
+    assert!(inner.lines.is_empty());
+}
