+#[test]
+fn metadata_is_allowlisted_and_child_tool_ids_cannot_replace_main_calls() {
+    let panel = Panel::new(vec![], FrameRequester::test_dummy());
+    panel.update(json!({"session_id":"main"}));
+    panel
+        .inner
+        .lock()
+        .unwrap()
+        .agents
+        .insert("child".into(), json!({"id":"child","status":"running"}));
+    panel.observe(&tool_event("main"), Some("main".into()));
+    panel.observe(&tool_event("child"), Some("main".into()));
+    panel.observe(&tool_event("unrelated"), Some("main".into()));
+    let inner = panel.inner.lock().unwrap();
+    assert_eq!(inner.tools.len(), 2);
+    assert!(inner.tools.contains_key("main:call"));
+    assert!(inner.tools.contains_key("child:call"));
+    assert!(
+        !serde_json::to_string(&inner.tools)
+            .unwrap()
+            .contains("SECRET")
+    );
