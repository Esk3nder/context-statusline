diff --git a/codex-rs/tui/src/chatwidget/context_statusline.rs b/codex-rs/tui/src/chatwidget/context_statusline.rs
new file mode 100644
index 000000000..e6a7fd215
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/context_statusline.rs
@@ -0,0 +1,43 @@
+//! Snapshot only allowlisted native fields for the optional external panel.
+use super::*;
+use serde_json::json;
+
+impl ChatWidget {
+    pub(crate) fn observe_custom_statusline(&self, notification: &ServerNotification) {
+        if let Some(panel) = &self.custom_statusline {
+            panel.observe(notification, self.thread_id.map(|id| id.to_string()));
+        }
+    }
+
+    pub(super) fn refresh_custom_statusline(&self) {
+        let Some(panel) = &self.custom_statusline else {
+            return;
+        };
+        let context = self
+            .token_info
+            .as_ref()
+            .filter(|_| !self.token_usage_pending)
+            .map(|info| {
+                json!({
+                    "used_tokens": info.last_token_usage.total_tokens,
+                    "window_tokens": info.model_context_window
+                })
+            });
+        panel.update(json!({
+            "schema_version": 1, "host":"codex", "session_id":self.thread_id,
+            "model":self.current_model(), "effort":self.current_reasoning_effort(),
+            "cwd":self.config.cwd.to_string_lossy(), "branch":self.status_line_branch,
+            "context":context,
+            "estimated_thread_cost_usd": self.thread_usage.estimate.as_ref().and_then(|usage|
+                usage.estimated_usage_usd_micros.map(|cost| cost as f64 / 1_000_000.0)),
+            "configuration":{"mcps": self.config.mcp_servers.get().len()},
+            "agent_roles": self.collab_agent_metadata.iter().take(64).map(|(id, meta)|
+                (id.to_string(), meta.agent_role.as_deref().or(meta.agent_nickname.as_deref()).unwrap_or("agent"))
+            ).collect::<std::collections::BTreeMap<_,_>>()
+        }));
+    }
+}
+
+#[cfg(test)]
+#[path = "context_statusline_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/chatwidget/context_statusline_tests.rs b/codex-rs/tui/src/chatwidget/context_statusline_tests.rs
new file mode 100644
index 000000000..f07c8e92a
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/context_statusline_tests.rs
@@ -0,0 +1,205 @@
+use super::*;
+use crate::chatwidget::tests::make_chatwidget_manual_with_sender;
+use crate::context_statusline::Panel;
+use pretty_assertions::assert_eq;
+use tempfile::tempdir;
+
+#[tokio::test]
+async fn embedded_panel_preserves_composer_and_disappears_before_input_when_short() {
+    let (mut widget, _, _, _) = make_chatwidget_manual_with_sender().await;
+    let dir = tempdir().unwrap();
+    let script = dir.path().join("renderer.py");
+    std::fs::write(&script, "print('CUSTOM CONTEXT 37%\\nCUSTOM QUOTA 22%')").unwrap();
+    widget.custom_statusline = Some(Panel::new(
+        vec![
+            if cfg!(windows) {
+                "python".into()
+            } else {
+                "python3".into()
+            },
+            script.to_string_lossy().into(),
+        ],
+        widget.frame_requester.clone(),
+    ));
+    widget.refresh_custom_statusline();
+    widget.handle_paste("draft stays here".into());
+    let options = crate::bottom_pane::ComposerRenderOptions::default;
+    for _ in 0..100 {
+        let bottom = widget.bottom_pane_renderable(options());
+        bottom.desired_height(80);
+        let mut buffer = ratatui::buffer::Buffer::empty(Rect::new(0, 0, 80, 12));
+        bottom.render(buffer.area, &mut buffer);
+        let text = buffer
+            .content
+            .iter()
+            .map(ratatui::buffer::Cell::symbol)
+            .collect::<String>();
+        if text.contains("CUSTOM CONTEXT") {
+            assert!(text.contains("draft stays here"));
+            let rendered = buffer
+                .content
+                .chunks(80)
+                .map(|row| {
+                    row.iter()
+                        .map(ratatui::buffer::Cell::symbol)
+                        .collect::<String>()
+                        .trim_end()
+                        .to_owned()
+                })
+                .collect::<Vec<_>>()
+                .join("\n")
+                .replace(&widget.config.cwd.display().to_string(), "/tmp/project");
+            insta::assert_snapshot!(rendered);
+            let mut tiny = ratatui::buffer::Buffer::empty(Rect::new(0, 0, 80, 3));
+            bottom.render(tiny.area, &mut tiny);
+            let tiny_text = tiny
+                .content
+                .iter()
+                .map(ratatui::buffer::Cell::symbol)
+                .collect::<String>();
+            assert!(tiny_text.contains("draft stays here"));
+            assert!(!tiny_text.contains("CUSTOM CONTEXT"));
+            assert_eq!(bottom.cursor_pos(tiny.area).is_some(), true);
+            return;
+        }
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    panic!("Custom renderer output was not embedded in the composer layout");
+}
+
+fn idle_panel(widget: &ChatWidget) -> Panel {
+    // An empty command never spawns a renderer; the payload is inspected directly.
+    Panel::new(vec![], widget.frame_requester.clone())
+}
+
+fn panel_payload(widget: &ChatWidget) -> serde_json::Value {
+    widget
+        .custom_statusline
+        .as_ref()
+        .unwrap()
+        .payload_for_test()
+}
+
+fn token_info(total_tokens: i64) -> crate::token_usage::TokenUsageInfo {
+    let usage = crate::token_usage::TokenUsage {
+        total_tokens,
+        ..Default::default()
+    };
+    crate::token_usage::TokenUsageInfo {
+        total_token_usage: usage.clone(),
+        last_token_usage: usage,
+        model_context_window: Some(100_000),
+    }
+}
+
+#[tokio::test]
+async fn token_usage_updates_reach_the_panel_during_a_turn() {
+    let (mut widget, _, _, _) = make_chatwidget_manual_with_sender().await;
+    widget.custom_statusline = Some(idle_panel(&widget));
+    widget.set_token_info(Some(token_info(12_000)));
+    assert_eq!(panel_payload(&widget)["context"]["used_tokens"], 12_000);
+    widget.set_token_info(Some(token_info(40_000)));
+    assert_eq!(panel_payload(&widget)["context"]["used_tokens"], 40_000);
+    widget.set_token_info(None);
+    assert!(panel_payload(&widget)["context"].is_null());
+}
+
+#[tokio::test]
+async fn panel_keeps_the_branch_lookup_alive_without_a_native_branch_item() {
+    let (mut widget, _, _, _) = make_chatwidget_manual_with_sender().await;
+    // A native status line without a git-branch item.
+    widget.local_settings.tui.status_line = Some(vec!["model-name".into()]);
+    widget.refresh_status_surfaces();
+    // Without the panel the shared branch cache is dropped and never looked up.
+    assert!(widget.status_line_branch_cwd.is_none());
+    widget.custom_statusline = Some(idle_panel(&widget));
+    widget.refresh_status_surfaces();
+    assert_eq!(
+        widget.status_line_branch_cwd.as_deref(),
+        Some(widget.config.cwd.as_path())
+    );
+}
+
+#[tokio::test]
+async fn panel_never_takes_more_than_a_third_of_the_screen() {
+    let (mut widget, _, _, _) = make_chatwidget_manual_with_sender().await;
+    widget.custom_statusline = Some(idle_panel(&widget));
+    widget
+        .custom_statusline
+        .as_ref()
+        .unwrap()
+        // The panel is inset by two columns on each side of an 80-column layout.
+        .set_lines_for_test((0..60).map(|i| format!("ROW {i}").into()).collect(), 76);
+    let options = crate::bottom_pane::ComposerRenderOptions::default;
+    let composer_only = {
+        let saved = widget.custom_statusline.take();
+        let height = widget.bottom_pane_renderable(options()).desired_height(80);
+        widget.custom_statusline = saved;
+        height
+    };
+    widget.note_screen_height(30);
+    let bottom = widget.bottom_pane_renderable(options());
+    assert_eq!(bottom.desired_height(80), composer_only + 10);
+    let mut buffer = ratatui::buffer::Buffer::empty(Rect::new(0, 0, 80, 30));
+    bottom.render(Rect::new(0, 0, 80, composer_only + 10), &mut buffer);
+    let text = buffer
+        .content
+        .iter()
+        .map(ratatui::buffer::Cell::symbol)
+        .collect::<String>();
+    assert!(text.contains("ROW 9"));
+    assert!(!text.contains("ROW 10"));
+    // Owned transcripts hand down a budget for the whole bottom region; the composer wins.
+    let capped = widget.bottom_pane_renderable(crate::bottom_pane::ComposerRenderOptions {
+        max_height: Some(composer_only + 2),
+        ..Default::default()
+    });
+    assert_eq!(capped.desired_height(80), composer_only + 2);
+}
+
+#[tokio::test]
+async fn live_plan_updates_delivered_to_the_widget_reach_the_panel() {
+    let (mut widget, _, _, _) = make_chatwidget_manual_with_sender().await;
+    let thread_id = ThreadId::new();
+    widget.thread_id = Some(thread_id);
+    widget.custom_statusline = Some(idle_panel(&widget));
+    // Buffered startup notifications arrive live, not as replays, once the widget is attached.
+    widget.handle_server_notification(
+        ServerNotification::TurnPlanUpdated(
+            codex_app_server_protocol::TurnPlanUpdatedNotification {
+                thread_id: thread_id.to_string(),
+                turn_id: "turn-1".into(),
+                explanation: None,
+                plan: vec![codex_app_server_protocol::TurnPlanStep {
+                    step: "write the test".into(),
+                    status: codex_app_server_protocol::TurnPlanStepStatus::InProgress,
+                }],
+            },
+        ),
+        /*replay_kind*/ None,
+    );
+    let plan = widget.custom_statusline.as_ref().unwrap().plan_for_test();
+    assert_eq!(plan.len(), 1);
+    assert_eq!(plan[0]["step"], "write the test");
+}
+
+#[tokio::test]
+async fn replayed_history_items_reach_the_panel() {
+    let (mut widget, _, _, _) = make_chatwidget_manual_with_sender().await;
+    widget.thread_id = Some(ThreadId::new());
+    widget.custom_statusline = Some(idle_panel(&widget));
+    let item: ThreadItem = serde_json::from_value(serde_json::json!({
+        "type":"mcpToolCall","id":"mcp-1","server":"github","tool":"search","status":"completed",
+        "arguments":{},"result":null,"error":null,"durationMs":null,"mcpApp":null,"contentItems":null
+    }))
+    .unwrap();
+    widget.replay_thread_item(item, "turn-1".into(), ReplayKind::ResumeInitialMessages);
+    assert_eq!(
+        widget
+            .custom_statusline
+            .as_ref()
+            .unwrap()
+            .used_mcps_for_test(),
+        vec!["github".to_owned()]
+    );
+}
